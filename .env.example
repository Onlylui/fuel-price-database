# Credenciais do PostgreSQL (usadas pelo docker-compose)
POSTGRES_USER=user
POSTGRES_PASSWORD=senha
POSTGRES_DB=fuel_price
# Porta exposta no host (5433 para não conflitar com um Postgres local na 5432)
POSTGRES_PORT=5433

# Usada ao rodar o pipeline fora do Docker.
# Dentro do container, o docker-compose sobrescreve com o host "db".
DATABASE_URL=postgresql+psycopg://luiz:senha@localhost:5433/fuel_price
